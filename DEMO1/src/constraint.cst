// 1. CLOCK & RESET
IO_LOC  "clk" 45;
IO_PORT "clk" PULL_MODE=UP;
IO_LOC  "rstn" 14;
IO_PORT "rstn" PULL_MODE=UP;

// 2. GIAO TIEP CAMERA OV2640
IO_LOC  "cam_sda" 46;
IO_PORT "cam_sda" PULL_MODE=UP;
IO_LOC  "cam_scl" 44;
IO_PORT "cam_scl" PULL_MODE=UP;
IO_LOC  "cam_xclk" 33;
// Ep xung nhip camera ve 2.5V de dong bo voi Bank 2 cua HDMI
IO_PORT "cam_xclk" IO_TYPE=LVCMOS25 PULL_MODE=UP DRIVE=8;
IO_LOC  "cam_pclk" 41;
IO_PORT "cam_pclk" PULL_MODE=UP;
IO_LOC  "cam_vsync" 43;
IO_PORT "cam_vsync" PULL_MODE=UP;
IO_LOC  "cam_href" 42;
IO_PORT "cam_href" PULL_MODE=UP;

// 8 Chan Data Camera
IO_LOC  "cam_data[7]" 8;
IO_PORT "cam_data[7]" PULL_MODE=UP;
IO_LOC  "cam_data[6]" 23;
IO_PORT "cam_data[6]" PULL_MODE=UP;
IO_LOC  "cam_data[5]" 16;
IO_PORT "cam_data[5]" PULL_MODE=UP;
IO_LOC  "cam_data[4]" 18;
IO_PORT "cam_data[4]" PULL_MODE=UP;
IO_LOC  "cam_data[3]" 20;
IO_PORT "cam_data[3]" PULL_MODE=UP;
IO_LOC  "cam_data[2]" 19;
IO_PORT "cam_data[2]" PULL_MODE=UP;
IO_LOC  "cam_data[1]" 17;
IO_PORT "cam_data[1]" PULL_MODE=UP;
IO_LOC  "cam_data[0]" 21;
IO_PORT "cam_data[0]" PULL_MODE=UP;

// 3. NGOAI VI (Su dung LED tich hop tren bo mach tai chan 10)
IO_LOC  "btn_capture" 15;
IO_PORT "btn_capture" PULL_MODE=UP;

IO_LOC  "led_status" 10;
IO_PORT "led_status" DRIVE=8;

// 4. DUMMY PINS CHO PORT UART TRONG SOC_TOP (Khong su dung)
IO_LOC  "uart_tx" 22;
IO_PORT "uart_tx" DRIVE=8;
IO_LOC  "uart_rx" 13;
IO_PORT "uart_rx" PULL_MODE=UP;

// 5. CONG XUAT HDMI (TMDS)
IO_LOC  "tmds_clk_p" 28, 27;
IO_PORT "tmds_clk_p" PULL_MODE=NONE;

IO_LOC  "tmds_data_p[0]" 30, 29;
IO_PORT "tmds_data_p[0]" PULL_MODE=NONE;

IO_LOC  "tmds_data_p[1]" 32, 31;
IO_PORT "tmds_data_p[1]" PULL_MODE=NONE;

IO_LOC  "tmds_data_p[2]" 35, 34;
IO_PORT "tmds_data_p[2]" PULL_MODE=NONE;